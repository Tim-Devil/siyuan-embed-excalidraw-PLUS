@@ -306,6 +351,425 @@ export class Fonts {
     }
   }
 
+  public static supportsLocalFontAccess() {
+    return (
+      typeof window !== "undefined" &&
+      typeof window.queryLocalFonts === "function"
+    );
+  }
+
+  public static async queryAndRegisterLocalFonts(): Promise<LocalFontQueryResult> {
+    const queryLocalFonts = window.queryLocalFonts;
+    if (typeof queryLocalFonts !== "function") {
+      throw new Error("Local Font Access API is unavailable");
+    }
+
+    const fontFaces = await queryLocalFonts.call(window);
+    const families = new Map<string, LocalFontAccessData[]>();
+
+    for (const fontFace of fontFaces) {
+      if (
+        !fontFace.family?.trim() ||
+        !fontFace.postscriptName?.trim() ||
+        typeof fontFace.blob !== "function"
+      ) {
+        continue;
+      }
+
+      const family = fontFace.family.trim();
+      const familyFaces = families.get(family) ?? [];
+      familyFaces.push(fontFace);
+      families.set(family, familyFaces);
+    }
+
+    let registeredCount = 0;
+    const fontFamilies = FONT_FAMILY as Record<string, number>;
+
+    for (const [family, faces] of Array.from(families.entries()).sort(
+      ([left], [right]) => left.localeCompare(right),
+    )) {
+      const existingFamilyId = fontFamilies[family];
+      if (
+        typeof existingFamilyId === "number" &&
+        existingFamilyId < LOCAL_FONT_ID_START
+      ) {
+        continue;
+      }
+
+      const preferredFace =
+        faces.find((fontFace) =>
+          /^(regular|normal|book|roman)$/i.test(fontFace.style.trim()),
+        ) ?? faces[0];
+
+      const descriptor = Fonts.registerLocalFontDescriptor(
+        {
+          id: Fonts.allocateLocalFontId(preferredFace.postscriptName),
+          family,
+          fullName: preferredFace.fullName?.trim() || family,
+          postscriptName: preferredFace.postscriptName.trim(),
+          style: preferredFace.style?.trim() || "Regular",
+          metrics: Fonts.getDefaultLocalFontMetrics(),
+        },
+        () => preferredFace.blob(),
+      );
+
+      if (descriptor.id >= LOCAL_FONT_ID_START) {
+        registeredCount++;
+      }
+    }
+
+    return {
+      faceCount: fontFaces.length,
+      familyCount: families.size,
+      registeredCount,
+    };
+  }
+
+  public static getLocalFontDescriptor(fontFamily: number) {
+    return Fonts.localFontDescriptors.get(fontFamily);
+  }
+
+  public static syncLocalFontCustomData(
+    customData: ExcalidrawElement["customData"],
+    fontFamily: number,
+  ): ExcalidrawElement["customData"] {
+    const descriptor = Fonts.localFontDescriptors.get(fontFamily);
+
+    if (descriptor) {
+      return {
+        ...customData,
+        [LOCAL_FONT_CUSTOM_DATA_KEY]: {
+          ...descriptor,
+          metrics: { ...descriptor.metrics },
+        },
+      };
+    }
+
+    if (customData && LOCAL_FONT_CUSTOM_DATA_KEY in customData) {
+      const nextCustomData = { ...customData };
+      delete nextCustomData[LOCAL_FONT_CUSTOM_DATA_KEY];
+      return Object.keys(nextCustomData).length ? nextCustomData : undefined;
+    }
+
+    return customData;
+  }
+
+  public static registerLocalFontsFromElements(
+    elements: readonly ExcalidrawElement[],
+  ) {
+    let registeredCount = 0;
+
+    for (const element of elements) {
+      if (!isTextElement(element)) {
+        continue;
+      }
+
+      const descriptor = Fonts.normalizeLocalFontDescriptor(
+        element.customData?.[LOCAL_FONT_CUSTOM_DATA_KEY],
+      );
+      if (!descriptor) {
+        continue;
+      }
+
+      Fonts.registerLocalFontDescriptor(descriptor);
+      registeredCount++;
+    }
+
+    return registeredCount;
+  }
+
+  public static resolveLocalFontFamily(
+    customData: ExcalidrawElement["customData"],
+    fallbackFontFamily: number,
+  ) {
+    const descriptor = Fonts.normalizeLocalFontDescriptor(
+      customData?.[LOCAL_FONT_CUSTOM_DATA_KEY],
+    );
+
+    return descriptor
+      ? Fonts.registerLocalFontDescriptor(descriptor).id
+      : fallbackFontFamily;
+  }
+
+  public static async prepareLocalFont(fontFamily: number) {
+    const loader = Fonts.localFontLoaders.get(fontFamily);
+    if (!loader || !Fonts.localFontDescriptors.has(fontFamily)) {
+      return;
+    }
+
+    if (Fonts.preparedLocalFontIds.has(fontFamily)) {
+      return;
+    }
+
+    const pending = Fonts.localFontPreparation.get(fontFamily);
+    if (pending) {
+      return pending;
+    }
+
+    const preparation = promiseTry(async () => {
+      try {
+        const blob = await loader();
+        const metrics = Fonts.parseOpenTypeMetrics(await blob.arrayBuffer());
+        if (!metrics) {
+          return;
+        }
+
+        const descriptor = Fonts.localFontDescriptors.get(fontFamily);
+        const registered = Fonts.registered.get(fontFamily);
+        if (!descriptor || !registered) {
+          return;
+        }
+
+        const nextDescriptor = { ...descriptor, metrics };
+        Fonts.localFontDescriptors.set(fontFamily, nextDescriptor);
+        registered.metadata = {
+          ...registered.metadata,
+          metrics,
+        };
+        Fonts.preparedLocalFontIds.add(fontFamily);
+      } catch (error) {
+        console.warn("Failed to read local font metrics", error);
+      }
+    }).finally(() => {
+      Fonts.localFontPreparation.delete(fontFamily);
+    });
+
+    Fonts.localFontPreparation.set(fontFamily, preparation);
+    return preparation;
+  }
+
+  private static registerLocalFontDescriptor(
+    input: LocalFontDescriptor,
+    loader?: () => Promise<Blob>,
+  ) {
+    const normalizedInput = Fonts.normalizeLocalFontDescriptor(input);
+    if (!normalizedInput) {
+      throw new Error("Invalid local font descriptor");
+    }
+
+    const knownId = Fonts.localFontIdsByPostscriptName.get(
+      normalizedInput.postscriptName,
+    );
+    if (knownId) {
+      if (loader) {
+        Fonts.localFontLoaders.set(knownId, loader);
+        return Fonts.localFontDescriptors.get(knownId)!;
+      }
+
+      const descriptor = { ...normalizedInput, id: knownId };
+      registerLocalFontFamilyName(knownId, descriptor.family);
+      Fonts.localFontDescriptors.set(knownId, descriptor);
+
+      const registered = Fonts.registered.get(knownId);
+      if (registered) {
+        registered.metadata = {
+          ...registered.metadata,
+          metrics: { ...descriptor.metrics },
+        };
+      }
+
+      return descriptor;
+    }
+
+    const builtInId = (FONT_FAMILY as Record<string, number>)[
+      normalizedInput.family
+    ];
+    if (typeof builtInId === "number" && builtInId < LOCAL_FONT_ID_START) {
+      return { ...normalizedInput, id: builtInId };
+    }
+
+    let id = normalizedInput.id;
+    const occupiedDescriptor = Fonts.localFontDescriptors.get(id);
+    if (
+      id < LOCAL_FONT_ID_START ||
+      Fonts.registered.has(id) ||
+      (occupiedDescriptor &&
+        occupiedDescriptor.postscriptName !== normalizedInput.postscriptName)
+    ) {
+      id = Fonts.allocateLocalFontId(normalizedInput.postscriptName);
+    }
+
+    const descriptor = { ...normalizedInput, id };
+    registerLocalFontFamilyName(descriptor.id, descriptor.family);
+    Fonts.localFontDescriptors.set(descriptor.id, descriptor);
+    Fonts.localFontIdsByPostscriptName.set(
+      descriptor.postscriptName,
+      descriptor.id,
+    );
+    if (loader) {
+      Fonts.localFontLoaders.set(descriptor.id, loader);
+    }
+
+    Fonts.registered.set(descriptor.id, {
+      metadata: {
+        metrics: { ...descriptor.metrics },
+        local: true,
+      },
+      fontFaces: [
+        new ExcalidrawFontFace(descriptor.family, LOCAL_FONT_PROTOCOL),
+      ],
+    });
+    return descriptor;
+  }
+
+  private static allocateLocalFontId(postscriptName: string) {
+    const knownId = Fonts.localFontIdsByPostscriptName.get(postscriptName);
+    if (knownId) {
+      return knownId;
+    }
+
+    let hash = 2166136261;
+    for (let index = 0; index < postscriptName.length; index++) {
+      hash ^= postscriptName.charCodeAt(index);
+      hash = Math.imul(hash, 16777619);
+    }
+
+    const maxId = 0x7ffffffe;
+    const range = maxId - LOCAL_FONT_ID_START;
+    let id = LOCAL_FONT_ID_START + ((hash >>> 0) % range);
+
+    while (Fonts.registered.has(id) || Fonts.localFontDescriptors.has(id)) {
+      id = id >= maxId ? LOCAL_FONT_ID_START : id + 1;
+    }
+
+    return id;
+  }
+
+  private static getDefaultLocalFontMetrics(): FontMetadata["metrics"] {
+    return { ...FONT_METADATA[FONT_FAMILY.Helvetica].metrics };
+  }
+
+  private static normalizeLocalFontDescriptor(
+    value: unknown,
+  ): LocalFontDescriptor | null {
+    if (!value || typeof value !== "object") {
+      return null;
+    }
+
+    const descriptor = value as Partial<LocalFontDescriptor>;
+    if (
+      !Number.isInteger(descriptor.id) ||
+      typeof descriptor.family !== "string" ||
+      !descriptor.family.trim() ||
+      typeof descriptor.postscriptName !== "string" ||
+      !descriptor.postscriptName.trim()
+    ) {
+      return null;
+    }
+
+    const fallbackMetrics = Fonts.getDefaultLocalFontMetrics();
+    const metrics = descriptor.metrics;
+    const normalizedMetrics = {
+      unitsPerEm:
+        Number.isFinite(metrics?.unitsPerEm) && metrics!.unitsPerEm > 0
+          ? metrics!.unitsPerEm
+          : fallbackMetrics.unitsPerEm,
+      ascender: Number.isFinite(metrics?.ascender)
+        ? metrics!.ascender
+        : fallbackMetrics.ascender,
+      descender: Number.isFinite(metrics?.descender)
+        ? metrics!.descender
+        : fallbackMetrics.descender,
+      lineHeight:
+        Number.isFinite(metrics?.lineHeight) && metrics!.lineHeight > 0
+          ? metrics!.lineHeight
+          : fallbackMetrics.lineHeight,
+    };
+
+    return {
+      id: descriptor.id!,
+      family: descriptor.family.trim(),
+      fullName:
+        typeof descriptor.fullName === "string" && descriptor.fullName.trim()
+          ? descriptor.fullName.trim()
+          : descriptor.family.trim(),
+      postscriptName: descriptor.postscriptName.trim(),
+      style:
+        typeof descriptor.style === "string" && descriptor.style.trim()
+          ? descriptor.style.trim()
+          : "Regular",
+      metrics: normalizedMetrics,
+    };
+  }
+
+  private static parseOpenTypeMetrics(
+    buffer: ArrayBuffer,
+  ): FontMetadata["metrics"] | null {
+    const view = new DataView(buffer);
+    const readTag = (offset: number) => {
+      if (offset < 0 || offset + 4 > view.byteLength) {
+        return "";
+      }
+      return String.fromCharCode(
+        view.getUint8(offset),
+        view.getUint8(offset + 1),
+        view.getUint8(offset + 2),
+        view.getUint8(offset + 3),
+      );
+    };
+
+    if (view.byteLength < 12) {
+      return null;
+    }
+
+    let fontOffset = 0;
+    if (readTag(0) === "ttcf") {
+      if (view.byteLength < 16 || view.getUint32(8, false) < 1) {
+        return null;
+      }
+      fontOffset = view.getUint32(12, false);
+    }
+
+    if (fontOffset + 12 > view.byteLength) {
+      return null;
+    }
+
+    const tableCount = view.getUint16(fontOffset + 4, false);
+    let headOffset = -1;
+    let hheaOffset = -1;
+
+    for (let index = 0; index < tableCount; index++) {
+      const recordOffset = fontOffset + 12 + index * 16;
+      if (recordOffset + 16 > view.byteLength) {
+        return null;
+      }
+
+      const tag = readTag(recordOffset);
+      const tableOffset = view.getUint32(recordOffset + 8, false);
+      if (tag === "head") {
+        headOffset = tableOffset;
+      } else if (tag === "hhea") {
+        hheaOffset = tableOffset;
+      }
+    }
+
+    if (
+      headOffset < 0 ||
+      hheaOffset < 0 ||
+      headOffset + 20 > view.byteLength ||
+      hheaOffset + 10 > view.byteLength
+    ) {
+      return null;
+    }
+
+    const unitsPerEm = view.getUint16(headOffset + 18, false);
+    const ascender = view.getInt16(hheaOffset + 4, false);
+    const descender = view.getInt16(hheaOffset + 6, false);
+    const lineGap = view.getInt16(hheaOffset + 8, false);
+    if (!unitsPerEm) {
+      return null;
+    }
+
+    const naturalLineHeight =
+      (ascender - descender + Math.max(0, lineGap)) / unitsPerEm;
+    const lineHeight = Math.min(
+      3,
+      Math.max(1, Math.round(naturalLineHeight * 1000) / 1000),
+    );
+
+    return { unitsPerEm, ascender, descender, lineHeight };
+  }
+
