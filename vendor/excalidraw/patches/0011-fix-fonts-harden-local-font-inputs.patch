+export const normalizeFontFamilyStyle = (fontFamily: string): string => {
+  const families: string[] = [];
+  let currentFamily = "";
+  let quote: '"' | "'" | null = null;
+  let escaped = false;
+
+  for (const character of fontFamily) {
+    if (escaped) {
+      currentFamily += character;
+      escaped = false;
+      continue;
+    }
+    if (character === "\\") {
+      currentFamily += character;
+      escaped = true;
+      continue;
+    }
+    if (quote) {
+      currentFamily += character;
+      if (character === quote) quote = null;
+      continue;
+    }
+    if (
+      (character === '"' || character === "'") &&
+      currentFamily.trim().length === 0
+    ) {
+      currentFamily += character;
+      quote = character;
+      continue;
+    }
+    if (character === ",") {
+      families.push(currentFamily);
+      currentFamily = "";
+      continue;
+    }
+    currentFamily += character;
+  }
+  families.push(currentFamily);
+
+  return families
+    .map((family) => {
+      const trimmedFamily = family.trim();
+      const outerQuote = trimmedFamily[0];
+      const unquotedFamily =
+        (outerQuote === '"' || outerQuote === "'") &&
+        trimmedFamily.at(-1) === outerQuote
+          ? trimmedFamily.slice(1, -1)
+          : trimmedFamily;
+      return unquotedFamily.replace(/\s+/g, " ").toLowerCase();
+    })
+    .join(",");
+};
 
