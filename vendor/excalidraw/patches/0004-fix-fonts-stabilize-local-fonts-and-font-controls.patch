 const FONT_SIZE_RELATIVE_INCREASE_STEP = 0.1;
 
+const getFontSizeInputValue = (fontSize: number | null) =>
+  fontSize === null ? "" : String(fontSize);
+
+const parseFontSizeInputValue = (inputValue: string) => {
+  const parsedValue = Number(inputValue);
+
+  if (!inputValue.trim() || !Number.isFinite(parsedValue)) {
+    return null;
+  }
+
+  return Math.max(MIN_FONT_SIZE, parsedValue);
+};
+
+const FontSizeInput = ({
+  value,
+  onChange,
+}: {
+  value: number | null;
+  onChange: (value: number) => void;
+}) => {
+  const [inputValue, setInputValue] = useState(getFontSizeInputValue(value));
+  const inputRef = useRef<HTMLInputElement>(null);
+
+  useEffect(() => {
+    // Keep intermediate values such as `27.` while the user is typing. The
+    // parent state updates on every valid keystroke.
+    if (document.activeElement !== inputRef.current) {
+      setInputValue(getFontSizeInputValue(value));
+    }
+  }, [value]);
+
+  const handleInputChange = (nextInputValue: string) => {
+    setInputValue(nextInputValue);
+
+    const parsedValue = Number(nextInputValue);
+    if (
+      nextInputValue.trim() &&
+      Number.isFinite(parsedValue) &&
+      parsedValue >= MIN_FONT_SIZE
+    ) {
+      const nextValue = parseFontSizeInputValue(nextInputValue);
+      if (nextValue !== null && nextValue !== value) {
+        onChange(nextValue);
+      }
+    }
+  };
+
+  const commitInputValue = () => {
+    const nextValue = parseFontSizeInputValue(inputValue);
+
+    if (nextValue === null) {
+      setInputValue(getFontSizeInputValue(value));
+      return;
+    }
+
+    setInputValue(String(nextValue));
+
+    if (nextValue !== value) {
+      onChange(nextValue);
+    }
+  };
+
+  return (
+    <div className="FontSizeInput properties-trigger">
+      <input
+        ref={inputRef}
+        type="text"
+        inputMode="decimal"
+        role="spinbutton"
+        aria-valuemin={MIN_FONT_SIZE}
+        className="properties-trigger"
+        aria-label={t("labels.fontSize")}
+        data-testid="font-size-input"
+        value={inputValue}
+        onChange={(event) => handleInputChange(event.target.value)}
+        onFocus={(event) => event.currentTarget.select()}
+        onBlur={commitInputValue}
+        onKeyDown={(event) => {
+          if (event.key === KEYS.ENTER) {
+            event.preventDefault();
+            event.stopPropagation();
+            commitInputValue();
+          } else if (event.key === KEYS.ESCAPE) {
+            event.preventDefault();
+            event.stopPropagation();
+            setInputValue(getFontSizeInputValue(value));
+          }
+        }}
+      />
+      <span aria-hidden="true">px</span>
+    </div>
+  );
+};
