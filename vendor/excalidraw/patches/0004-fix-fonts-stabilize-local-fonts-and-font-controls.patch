diff --git a/packages/excalidraw/components/FontPicker/keyboardNavHandlers.test.ts b/packages/excalidraw/components/FontPicker/keyboardNavHandlers.test.ts
new file mode 100644
index 0000000..098fb97
--- /dev/null
+++ b/packages/excalidraw/components/FontPicker/keyboardNavHandlers.test.ts
@@ -0,0 +1,66 @@
+import { vi } from "vitest";
+import { fontPickerKeyHandler } from "./keyboardNavHandlers";
+
+const createEvent = (key: string) =>
+  ({
+    key,
+    ctrlKey: false,
+    metaKey: false,
+    shiftKey: false,
+    preventDefault: vi.fn(),
+    stopPropagation: vi.fn(),
+  } as any);
+
+const createFont = (value: number) => ({ value } as any);
+
+describe("font picker keyboard navigation", () => {
+  const fonts = [createFont(1), createFont(2), createFont(3)];
+
+  it("wraps upward from the first item to the last item", () => {
+    const onHover = vi.fn();
+
+    fontPickerKeyHandler({
+      event: createEvent("ArrowUp"),
+      inputRef: { current: null },
+      hoveredFont: fonts[0],
+      filteredFonts: fonts,
+      onClose: vi.fn(),
+      onSelect: vi.fn(),
+      onHover,
+    });
+
+    expect(onHover).toHaveBeenCalledWith(3);
+  });
+
+  it("wraps downward from the last item to the first item", () => {
+    const onHover = vi.fn();
+
+    fontPickerKeyHandler({
+      event: createEvent("ArrowDown"),
+      inputRef: { current: null },
+      hoveredFont: fonts[2],
+      filteredFonts: fonts,
+      onClose: vi.fn(),
+      onSelect: vi.fn(),
+      onHover,
+    });
+
+    expect(onHover).toHaveBeenCalledWith(1);
+  });
+
+  it("uses the filtered list when the hovered item is stale", () => {
+    const onHover = vi.fn();
+
+    fontPickerKeyHandler({
+      event: createEvent("ArrowUp"),
+      inputRef: { current: null },
+      hoveredFont: createFont(99),
+      filteredFonts: fonts,
+      onClose: vi.fn(),
+      onSelect: vi.fn(),
+      onHover,
+    });
+
+    expect(onHover).toHaveBeenCalledWith(3);
+  });
+});
