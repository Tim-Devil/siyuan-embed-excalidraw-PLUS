diff --git a/packages/excalidraw/components/FontPicker/FontPicker.scss b/packages/excalidraw/components/FontPicker/FontPicker.scss
index 5a57258..5d398f0 100644
--- a/packages/excalidraw/components/FontPicker/FontPicker.scss
+++ b/packages/excalidraw/components/FontPicker/FontPicker.scss
@@ -12,4 +12,84 @@
       ); // 4 gaps + 4 buttons
     }
   }
+
+  .FontPicker__local-fonts {
+    display: grid;
+    gap: 0.25rem;
+    padding: 0.5rem 0.5rem 0.25rem;
+  }
+
+  .FontPicker__local-fonts-button {
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    gap: 0.5rem;
+    min-height: 2.25rem;
+    padding: 0 0.75rem;
+    border: 1px solid var(--button-gray-3);
+    border-radius: var(--border-radius-md);
+    color: var(--text-primary-color);
+    background: var(--button-gray-1);
+    cursor: pointer;
+
+    &:hover:not(:disabled) {
+      background: var(--button-hover-bg);
+    }
+
+    &:disabled {
+      cursor: default;
+      opacity: 0.6;
+    }
+  }
+
+  .FontPicker__local-fonts-icon {
+    display: inline-flex;
+    width: 1rem;
+    height: 1rem;
+  }
+
+  .FontPicker__local-fonts-status {
+    min-height: 1rem;
+    color: var(--color-gray-60);
+    font-size: 0.75rem;
+    line-height: 1rem;
+    text-align: center;
+
+    &.is-error {
+      color: var(--color-danger);
+    }
+  }
+
+  .FontPicker__popover {
+    max-inline-size: calc(100vw - 1rem);
+
+    > .Island {
+      inline-size: max-content;
+      min-inline-size: min(24ch, calc(100vw - 1rem));
+      max-inline-size: min(48ch, calc(100vw - 1rem));
+    }
+
+    .FontPicker__font-item.dropdown-menu-item {
+      height: auto;
+      min-height: 2rem;
+      padding-block: 0.375rem;
+
+      .dropdown-menu-item__text {
+        overflow: visible;
+        white-space: normal;
+        overflow-wrap: anywhere;
+        text-overflow: clip;
+        line-height: 1.3;
+      }
+    }
+
+    .FontPicker__group .dropdown-menu-group-title {
+      font-weight: 600;
+    }
+
+    .FontPicker__group--local {
+      padding-top: 0.75rem;
+      border-top: 1px solid var(--default-border-color);
+    }
+  }
 }
