+type LocalFontStatus =
+  | { type: "idle" }
+  | { type: "loading" }
+  | { type: "ready"; count: number }
+  | { type: "unsupported" }
+  | { type: "error" };
+
+const stripSerializedFontFamilyQuotes = (fontFamily: string) => {
+  const trimmedFontFamily = fontFamily.trim();
+  const firstCharacter = trimmedFontFamily[0];
+
+  if (
+    (firstCharacter === '"' || firstCharacter === "'") &&
+    trimmedFontFamily.at(-1) === firstCharacter
+  ) {
+    return trimmedFontFamily.slice(1, -1);
+  }
+
+  return trimmedFontFamily;
+};
+
+const getFontDescriptors = () =>
+  Array.from(Fonts.registered.entries())
+    .filter(([, { metadata }]) => !metadata.serverSide && !metadata.fallback)
+    .map(([familyId, { metadata, fontFaces }]) => {
+      const localFontDescriptor = Fonts.getLocalFontDescriptor(familyId);
+      const fontDescriptor = {
+        value: familyId,
+        icon: metadata.icon ?? FontFamilyNormalIcon,
+        text:
+          localFontDescriptor?.family ??
+          stripSerializedFontFamilyQuotes(
+            fontFaces[0]?.fontFace?.family ?? "Unknown",
+          ),
+        source: localFontDescriptor ? "local" : "builtIn",
+      };
+
+      if (metadata.deprecated) {
+        Object.assign(fontDescriptor, {
+          deprecated: metadata.deprecated,
+          badge: {
+            type: DropDownMenuItemBadgeType.RED,
+            placeholder: t("fontList.badge.old"),
+          },
+        });
+      }
+
+      return fontDescriptor as FontDescriptor;
+    })
+    .sort((a, b) =>
+      a.text.localeCompare(b.text, undefined, { sensitivity: "base" }),
+    );
+
 export const FontPickerList = React.memo(
   ({
     selectedFontFamily,
